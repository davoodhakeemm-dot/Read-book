rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAccountOperator(accountId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(accountId)) &&
        request.auth.uid in get(/databases/$(database)/documents/users/$(accountId)).data.authorizedFirebaseUids;
    }

    function isBlockedPair(accountA, accountB) {
      return exists(/databases/$(database)/documents/users/$(accountA)/blocked/$(accountB)) ||
        exists(/databases/$(database)/documents/users/$(accountB)/blocked/$(accountA));
    }

    function isValidSecretTheme(theme) {
      return theme == 'INSTAGRAM' || theme == 'EMERALD' || theme == 'DARK';
    }

    function isValidUserProfile(data, accountId) {
      return data.accountId == accountId &&
        isValidId(data.accountId) &&
        data.ownerFirebaseUid is string && data.ownerFirebaseUid.size() >= 1 && data.ownerFirebaseUid.size() <= 128 &&
        data.authorizedFirebaseUids is list && data.authorizedFirebaseUids.size() >= 1 && data.authorizedFirebaseUids.size() <= 10 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 240)) &&
        (!('dpUrl' in data) || (data.dpUrl is string && data.dpUrl.size() <= 450000)) &&
        isValidSecretTheme(data.secretTheme) &&
        data.online is bool &&
        data.lastActive is timestamp && data.lastActive <= request.time &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserPrivate(data, accountId) {
      return data.accountId == accountId &&
        isValidId(data.accountId) &&
        data.phoneE164 is string && data.phoneE164.size() >= 6 && data.phoneE164.size() <= 24 &&
        data.phoneVerified is bool &&
        data.personalLinkToken is string && data.personalLinkToken.size() <= 128 &&
        data.activeTokenHash is string && data.activeTokenHash.size() <= 64 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidBlockedUser(data, blockedAccountId) {
      return data.blockedAccountId == blockedAccountId &&
        isValidId(data.blockedAccountId) &&
        data.blockedDisplayName is string && data.blockedDisplayName.size() >= 1 && data.blockedDisplayName.size() <= 80 &&
        data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidPhoneClaim(data, phoneHash) {
      return data.phoneHash == phoneHash &&
        phoneHash.size() == 64 && phoneHash.matches('^[a-f0-9]{64}$') &&
        isValidId(data.accountId) &&
        data.ownerFirebaseUid is string && data.ownerFirebaseUid.size() >= 1 && data.ownerFirebaseUid.size() <= 128 &&
        data.passwordSalt is string && data.passwordSalt.size() >= 8 && data.passwordSalt.size() <= 64 &&
        data.passwordHash is string && data.passwordHash.size() >= 32 && data.passwordHash.size() <= 128 &&
        data.phoneVerified is bool &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidNfcLink(data, tokenHash) {
      return data.tokenHash == tokenHash &&
        tokenHash.size() == 64 && tokenHash.matches('^[a-f0-9]{64}$') &&
        isValidId(data.accountId) &&
        data.ownerFirebaseUid is string && data.ownerFirebaseUid.size() >= 1 && data.ownerFirebaseUid.size() <= 128 &&
        data.revoked is bool &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidConversation(data) {
      return data.memberAccountIds is list && data.memberAccountIds.size() == 2 &&
        data.memberFirebaseUids is list && data.memberFirebaseUids.size() >= 1 && data.memberFirebaseUids.size() <= 20 &&
        data.lastMessageText is string && data.lastMessageText.size() <= 500 &&
        isValidId(data.lastSenderAccountId) &&
        data.lastMessageAt is timestamp && data.lastMessageAt <= request.time &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMessage(data, threadId) {
      return data.threadId == threadId &&
        isValidId(data.senderAccountId) &&
        isValidId(data.recipientAccountId) &&
        data.senderAccountId != data.recipientAccountId &&
        data.senderFirebaseUid is string && data.senderFirebaseUid.size() >= 1 &&
        data.memberFirebaseUids is list && data.memberFirebaseUids.size() >= 1 && data.memberFirebaseUids.size() <= 20 &&
        data.text is string && data.text.size() <= 4000 &&
        (!('mediaDataUri' in data) || (data.mediaDataUri is string && data.mediaDataUri.size() <= 850000)) &&
        (!('mediaKind' in data) || (data.mediaKind == 'IMAGE' || data.mediaKind == 'VIDEO' || data.mediaKind == 'AUDIO')) &&
        data.seen is bool &&
        (!('seenAt' in data) || (data.seenAt is timestamp && data.seenAt <= request.time)) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCallSignal(data, threadId) {
      return data.threadId == threadId &&
        isValidId(data.senderAccountId) &&
        isValidId(data.recipientAccountId) &&
        data.senderAccountId != data.recipientAccountId &&
        data.senderFirebaseUid is string && data.senderFirebaseUid.size() >= 1 &&
        data.memberFirebaseUids is list && data.memberFirebaseUids.size() >= 1 && data.memberFirebaseUids.size() <= 20 &&
        (data.callType == 'AUDIO' || data.callType == 'VIDEO') &&
        (data.status == 'RINGING' || data.status == 'ACCEPTED' || data.status == 'DECLINED' || data.status == 'ENDED') &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{accountId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
        isValidUserProfile(request.resource.data, accountId) &&
        request.resource.data.ownerFirebaseUid == request.auth.uid &&
        request.auth.uid in request.resource.data.authorizedFirebaseUids;

      allow update: if isSignedIn() &&
        isValidUserProfile(request.resource.data, accountId) &&
        request.resource.data.accountId == resource.data.accountId &&
        request.resource.data.ownerFirebaseUid == resource.data.ownerFirebaseUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (
          (request.auth.uid in resource.data.authorizedFirebaseUids &&
           request.resource.data.ownerFirebaseUid in request.resource.data.authorizedFirebaseUids) ||
          (request.auth.token.phone_number != null &&
           exists(/databases/$(database)/documents/users/$(accountId)/private/account) &&
           get(/databases/$(database)/documents/users/$(accountId)/private/account).data.phoneE164 == request.auth.token.phone_number &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorizedFirebaseUids', 'updatedAt', 'lastActive', 'online']) &&
           request.resource.data.authorizedFirebaseUids.hasAll(resource.data.authorizedFirebaseUids) &&
           request.auth.uid in request.resource.data.authorizedFirebaseUids)
        );

      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerFirebaseUid;

      match /private/{docId} {
        allow list: if false;
        allow get: if isAccountOperator(accountId);
        allow create: if docId == 'account' &&
          isAccountOperator(accountId) &&
          isValidUserPrivate(request.resource.data, accountId);
        allow update: if docId == 'account' &&
          isAccountOperator(accountId) &&
          isValidUserPrivate(request.resource.data, accountId) &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isAccountOperator(accountId);
      }

      match /blocked/{blockedAccountId} {
        allow get, list: if isAccountOperator(accountId);
        allow create: if isAccountOperator(accountId) &&
          blockedAccountId != accountId &&
          isValidBlockedUser(request.resource.data, blockedAccountId);
        allow update: if false;
        allow delete: if isAccountOperator(accountId);
      }
    }

    match /phone_claims/{phoneHash} {
      allow list: if false;
      allow get: if isSignedIn();
      allow create: if isSignedIn() &&
        !exists(/databases/$(database)/documents/phone_claims/$(phoneHash)) &&
        request.resource.data.ownerFirebaseUid == request.auth.uid &&
        isValidPhoneClaim(request.resource.data, phoneHash);
      allow update: if isSignedIn() &&
        isValidPhoneClaim(request.resource.data, phoneHash) &&
        request.resource.data.accountId == resource.data.accountId &&
        request.resource.data.ownerFirebaseUid == resource.data.ownerFirebaseUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (
          isAccountOperator(resource.data.accountId) ||
          (request.auth.token.phone_number != null &&
           exists(/databases/$(database)/documents/users/$(resource.data.accountId)/private/account) &&
           get(/databases/$(database)/documents/users/$(resource.data.accountId)/private/account).data.phoneE164 == request.auth.token.phone_number)
        );
      allow delete: if isAccountOperator(resource.data.accountId);
    }

    match /nfc_links/{tokenHash} {
      allow list: if false;
      allow get: if isSignedIn();
      allow create: if isSignedIn() &&
        isValidNfcLink(request.resource.data, tokenHash) &&
        request.resource.data.ownerFirebaseUid == request.auth.uid &&
        isAccountOperator(request.resource.data.accountId);
      allow update: if isSignedIn() &&
        isValidNfcLink(request.resource.data, tokenHash) &&
        request.resource.data.accountId == resource.data.accountId &&
        request.resource.data.ownerFirebaseUid == resource.data.ownerFirebaseUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        isAccountOperator(resource.data.accountId);
      allow delete: if isAccountOperator(resource.data.accountId);
    }

    match /conversations/{threadId} {
      allow get, list: if isSignedIn() && request.auth.uid in resource.data.memberFirebaseUids;

      allow create: if isSignedIn() &&
        isValidConversation(request.resource.data) &&
        request.auth.uid in request.resource.data.memberFirebaseUids &&
        isAccountOperator(request.resource.data.lastSenderAccountId) &&
        request.resource.data.lastSenderAccountId in request.resource.data.memberAccountIds &&
        !isBlockedPair(request.resource.data.memberAccountIds[0], request.resource.data.memberAccountIds[1]);

      allow update: if isSignedIn() &&
        isValidConversation(request.resource.data) &&
        request.resource.data.memberAccountIds == resource.data.memberAccountIds &&
        request.resource.data.createdAt == resource.data.createdAt &&
        isAccountOperator(request.resource.data.lastSenderAccountId) &&
        request.resource.data.lastSenderAccountId in resource.data.memberAccountIds &&
        !isBlockedPair(resource.data.memberAccountIds[0], resource.data.memberAccountIds[1]);

      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if isSignedIn() && request.auth.uid in resource.data.memberFirebaseUids;

        allow create: if isSignedIn() &&
          isValidMessage(request.resource.data, threadId) &&
          request.resource.data.senderFirebaseUid == request.auth.uid &&
          request.auth.uid in request.resource.data.memberFirebaseUids &&
          isAccountOperator(request.resource.data.senderAccountId) &&
          !isBlockedPair(request.resource.data.senderAccountId, request.resource.data.recipientAccountId);

        allow update: if isSignedIn() &&
          isValidMessage(request.resource.data, threadId) &&
          isAccountOperator(resource.data.recipientAccountId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'seenAt', 'updatedAt']) &&
          request.resource.data.seen == true;

        allow delete: if isAccountOperator(resource.data.senderAccountId);
      }

      match /calls/{callId} {
        allow get, list: if isSignedIn() && request.auth.uid in resource.data.memberFirebaseUids;

        allow create: if isSignedIn() &&
          isValidCallSignal(request.resource.data, threadId) &&
          request.resource.data.senderFirebaseUid == request.auth.uid &&
          request.auth.uid in request.resource.data.memberFirebaseUids &&
          isAccountOperator(request.resource.data.senderAccountId) &&
          !isBlockedPair(request.resource.data.senderAccountId, request.resource.data.recipientAccountId);

        allow update: if isSignedIn() &&
          isValidCallSignal(request.resource.data, threadId) &&
          (isAccountOperator(resource.data.senderAccountId) || isAccountOperator(resource.data.recipientAccountId)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);

        allow delete: if false;
      }
    }
  }
}
